{% extends '@OroUI/actions/update.html.twig' %}

{% oro_title_set({params : {'%title%': entity|oro_format_name|default('N/A'|trans), '%entityName%': 'dylvn.faq.category.entity_label'|trans} }) %}

{% set formAction = form.vars.value.id ? path('dylvn_faq_category_update', { 'id': form.vars.value.id }) : path('dylvn_faq_category_create')  %}

{% block navButtons %}
    {% import '@OroUI/macros.html.twig' as UI %}

    {{ parent() }}

    {{ UI.cancelButton(path('dylvn_faq_category_index')) }}
    {% set html = UI.saveAndCloseButton({
        'route': 'dylvn_faq_category_view',
        'params': {'id': '$id'}
    }) %}
    {% if is_granted('dylvn_faq_category_create') %}
        {% set html = html ~ UI.saveAndNewButton({
            'route': 'dylvn_faq_category_create'
        }) %}
    {% endif %}
    {% if entity.id or is_granted('dylvn_faq_category_update') %}
        {% set html = html ~ UI.saveAndStayButton({
            'route': 'dylvn_faq_category_update',
            'params': {'id': '$id'}
        }) %}
    {% endif %}
    {{ UI.dropdownSaveButton({'html': html}) }}
{% endblock %}

{% block pageHeader %}
    {% if entity.id %}
        {% set breadcrumbs = {
            'entity':      entity,
            'indexPath':   path('dylvn_faq_category_index'),
            'indexLabel': 'dylvn.faq.category.entity_plural_label'|trans,
            'entityTitle': entity|oro_format_name|default('N/A'|trans)
        } %}
        {{ parent() }}
    {% else %}
        {% set title = 'oro.ui.create_entity'|trans({'%entityName%': 'dylvn.faq.category.entity_label'|trans}) %}
        {% include '@OroUI/page_title_block.html.twig' with { title: title } %}
    {% endif %}
{% endblock pageHeader %}

{% block stats %}
    <li>{{ 'oro.ui.created_at'|trans }}: {{ entity.createdAt ? entity.createdAt|oro_format_datetime : 'N/A' }}</li>
    <li>{{ 'oro.ui.updated_at'|trans }}: {{ entity.updatedAt ? entity.updatedAt|oro_format_datetime : 'N/A' }}</li>
{% endblock stats %}

{% block content_data %}
    {% set dataBlocks = [
        {
            'title': 'dylvn.faq.section.category.general.label'|trans,
            'subblocks': [
            {
                'data' : [
                form_row(form.code),
                form_row(form.titles),
                form_row(form.descriptions),
                form_row(form.position),
                form_row(form.enabled),
                form_row(form.visibleOnFaqPage)
            ]
            }
        ]
        },
    ] %}

    {% set dataBlocks = dataBlocks|merge(oro_form_additional_data(form, 'Additional'|trans)) %}

    {% set dataBlocks = dataBlocks|merge({
        'kitItems': {
            'title': 'Category Items'|trans,
            'priority': 300,
            'subblocks': [{
                'title': '',
                'data': {
                    'steps': form_row(form.categoryItems)
                }
            }]
        }
    }) %}

    {% set data = {
        'formErrors': form_errors(form),
        'dataBlocks': dataBlocks
    }%}

    {% set id = 'dylvn-faq-category-edit' %}
    {{ parent() }}
{% endblock content_data %}
