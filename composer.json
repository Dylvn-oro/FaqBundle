{
  "name": "dylvn/faq-bundle",
  "description": "Oro FAQ (Frequently asked questions) integration",
  "type": "symfony-bundle",
  "keywords": ["Oro", "FAQ", "question", "Orocommerce"],
  "license": "MIT",
  "authors": [
    {
      "name": "Dylan Trochain"
    }
  ],
  "autoload": {
    "psr-4": {"Dylvn\\Bundle\\FaqBundle\\": "src/Dylvn/Bundle/FaqBundle"},
    "exclude-from-classmap": ["**/Tests/"]
  },
  "require": {
    "oro/commerce": "6.1.*",
    "dylvn/core-bundle": "6.1.*"
  },
  "repositories": {
    "oro": {
      "type": "composer",
      "url": "https://packagist.oroinc.com"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-master": "6.0-dev"
    }
  }
}
